#!/usr/bin/env bash
#
# paf-vcs — provider-agnostic VCS adapter for PAF.
#
# The three orchestrator skills (create-issue, implement-issue, check-out) call
# this adapter instead of `gh`/`glab` directly, so PAF works on both GitHub and
# GitLab projects without any per-skill provider branching.
#
# Provider detection is automatic, per project, from the git `origin` remote:
#   github.com, ssh.github.com    -> gh (GitHub CLI)
#   gitlab.com, altssh.gitlab.com -> glab (GitLab CLI)
# (ssh.github.com and altssh.gitlab.com are the providers' port-443 SSH hosts.)
# The host is matched exactly (not a loose substring), and any other host is a
# clear, non-silent failure — self-hosted/custom-domain instances, SSH host
# aliases, and an explicit provider override are out of scope. The project path
# is taken from the origin remote: the `glab` issue verbs name the project with
# `-R https://gitlab.com/<path>`, and `create-change-request` POSTs to the
# gitlab.com REST API through `glab api --hostname gitlab.com` with the
# URL-encoded path, so no git remote is consulted.
#
# Usage:
#   paf-vcs provider
#   paf-vcs auth-status
#   paf-vcs create-issue --title <t> [--label <l> ...]        (body on stdin)
#   paf-vcs view-issue <id>
#   paf-vcs comment-issue <id>                                 (message on stdin)
#   paf-vcs list-labels
#   paf-vcs create-change-request --base <branch> --title <t>  (body on stdin)
#
# `create-issue` and `create-change-request` print machine-parseable
# `NUMBER=<n>` / `URL=<url>` lines, a `---` separator, then the raw provider
# output — for a GitLab merge request, the MR URL only, since the API response
# echoes the whole description. Every other verb passes the provider CLI's
# output through as-is.

set -euo pipefail

err() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

# Host component of a git remote URL, handling SSH (git@host:path) and
# HTTPS (scheme://[user[:pass]@]host/path) forms. Provider detection matches
# the real host exactly (not a spoofable substring), and any credentials
# embedded in the URL are dropped here so they never reach error output.
remote_host() {
  printf '%s' "$1" | sed -E 's#^[a-zA-Z][a-zA-Z0-9+.-]*://##; s#^[^@/]*@##; s#[:/].*$##'
}

# Project path of a git remote URL — everything after the host (and port) in
# the scheme form, after the first ':' in the SSH (git@host:path) form — with
# one leading '/', one trailing '/' and one trailing '.git' dropped. Credentials never reach it.
remote_path() {
  local url="$1" rest path=""
  case "$url" in
    *://*)
      rest="${url#*://}"
      case "$rest" in */*) path="${rest#*/}" ;; esac
      ;;
    *:*) path="${url#*:}" ;;
  esac
  path="${path#/}"
  path="${path%/}"
  path="${path%.git}"
  printf '%s' "$path"
}

origin_url() {
  git remote get-url origin 2>/dev/null </dev/null \
    || err "could not read the 'origin' remote — are you inside a git repository that has an 'origin' remote? paf-vcs auto-detects the VCS provider from 'git remote get-url origin'."
}

detect_provider() {
  local url host
  url="$(origin_url)"
  host="$(remote_host "$url")"
  case "$host" in
    github.com|ssh.github.com) echo "gh" ;;
    gitlab.com|altssh.gitlab.com) echo "glab" ;;
    *)
      err "unsupported VCS host '${host}' in the origin remote. paf-vcs supports github.com / ssh.github.com (gh) and gitlab.com / altssh.gitlab.com (glab) only; self-hosted/custom-domain GitHub Enterprise or GitLab instances and SSH host aliases are out of scope — no silent fallback."
      ;;
  esac
}

# The origin's GitLab project path (e.g. group/sub/project).
glab_path() {
  local url path
  url="$(origin_url)"
  path="$(remote_path "$url")"
  [ -n "$path" ] \
    || err "could not read the project path from the origin remote; expected e.g. git@gitlab.com:group/project.git."
  printf '%s\n' "$path"
}

# The `-R` value every glab issue verb gets: the full gitlab.com URL of the
# origin's project, so glab never resolves the project from the remotes itself.
glab_repo() {
  local path
  # `|| exit`: a command substitution does not inherit `set -e`.
  path="$(glab_path)" || exit
  printf 'https://gitlab.com/%s\n' "$path"
}

# The REST API `:id` of the origin's project: its path URL-encoded. The path
# must be group/project segments of the characters GitLab allows in a path, so
# encoding is only `/` -> `%2F` and nothing else can reach the endpoint.
glab_project_id() {
  local path
  # `|| exit`: a command substitution does not inherit `set -e`.
  path="$(glab_path)" || exit
  [[ "$path" =~ ^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$ ]] \
    || err "the origin remote's project path is not a gitlab.com project path (group/project, segments of letters, digits, '.', '_' or '-')."
  printf '%s\n' "${path//\//%2F}"
}

# The create-MR request body: one JSON document, so no glab field conversion
# can alter a value. argv: source branch, target branch, title; stdin: description,
# read as bytes so carriage returns are not folded into newlines.
MR_REQUEST_PY='import json, sys
json.dump({"source_branch": sys.argv[1], "target_branch": sys.argv[2],
           "title": sys.argv[3],
           "description": sys.stdin.buffer.read().decode("utf-8")}, sys.stdout)'

# Reads the create-MR response on stdin and prints the NUMBER=/URL=/--- lines
# from its `iid` and `web_url`; exits 1 when either is missing or malformed.
MR_RESPONSE_PY='import json, sys
try:
    mr = json.load(sys.stdin)
except ValueError:
    sys.exit(1)
if not isinstance(mr, dict):
    sys.exit(1)
iid, url = mr.get("iid"), mr.get("web_url")
if type(iid) is not int or iid <= 0:
    sys.exit(1)
if not isinstance(url, str) or not url or any(c.isspace() for c in url):
    sys.exit(1)
sys.stdout.write("NUMBER=%d\nURL=%s\n---\n%s\n" % (iid, url, url))'

# Create a GitLab MR through glab's direct API call to gitlab.com. Unlike
# `glab mr create`, `glab api --hostname` never resolves the git remotes.
# glab's stderr goes straight to the caller; only stdout is parsed.
glab_create_mr() {
  local base="$1" source="$2" title="$3" body="$4" id payload output rc=0
  id="$(glab_project_id)"
  payload="$(printf '%s' "$body" | python3 -I -c "$MR_REQUEST_PY" "$source" "$base" "$title")"
  output="$(printf '%s' "$payload" | glab api --hostname gitlab.com --method POST \
    -H "Content-Type: application/json" "projects/${id}/merge_requests" --input -)" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$output" >&2
    exit "$rc"
  fi
  printf '%s' "$output" | python3 -I -c "$MR_RESPONSE_PY" || {
    printf '%s\n' "$output" >&2
    err "could not read the MR's iid and web_url from the GitLab API response above; not guessing the identifier."
  }
}

require_cli() {
  local cli="$1"
  command -v "$cli" >/dev/null 2>&1 </dev/null \
    || err "'$cli' is required but not installed. Install it (see https://cli.github.com for gh, https://gitlab.com/gitlab-org/cli for glab) and re-run."
  "$cli" auth status </dev/null >/dev/null 2>&1 \
    || err "'$cli' is not authenticated. Run '$cli auth login' and re-run."
}

# Detect the provider and confirm its CLI is installed + authenticated, then
# print the provider name. Every verb that talks to a provider starts here.
resolve_provider() {
  local provider
  provider="$(detect_provider)"
  require_cli "$provider"
  printf '%s\n' "$provider"
}

# Read an stdin-delivered body/message, failing clearly (instead of hanging on
# a terminal) if the verb was invoked without piped/heredoc input. $1 = verb.
read_stdin() {
  if [ -t 0 ]; then
    err "$1: expected content on stdin (e.g. via a heredoc); got none."
  fi
  cat
}

# Parse the provider CLI's combined stdout+stderr for the last issue/PR/MR URL
# and print machine-parseable identifier lines followed by the raw output.
# `tail -1` takes the last matching URL, which for `gh`/`glab` create output is
# the created resource; a body that itself embeds an issue/PR-shaped URL is a
# theoretical decoy; an issue body is not human-reviewed before posting
# (create-issue has no review gate), so treat the match as best-effort.
# The `|| true` guards keep an empty grep match (no URL) from aborting the
# script under `set -e` before the graceful error below can run.
extract_identifier() {
  local output="$1" url number
  url="$(printf '%s\n' "$output" | grep -Eo 'https?://[^[:space:]]+/(issues|pull|merge_requests)/[0-9]+' | tail -1 || true)"
  if [ -z "$url" ]; then
    printf '%s\n' "$output"
    err "could not find an issue/PR/MR URL in the provider CLI output above; not guessing the identifier."
  fi
  number="$(printf '%s\n' "$url" | grep -Eo '[0-9]+$' || true)"
  printf 'NUMBER=%s\n' "$number"
  printf 'URL=%s\n' "$url"
  printf -- '---\n'
  printf '%s\n' "$output"
}

# Shared tail for the two create verbs: on CLI failure surface the output and
# exit with its status; otherwise parse and print the identifier.
finish_create() {
  local rc="$1" output="$2"
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$output" >&2
    exit "$rc"
  fi
  extract_identifier "$output"
}

cmd_auth_status() {
  local provider
  provider="$(resolve_provider)"
  echo "provider: $provider (authenticated)"
}

cmd_create_issue() {
  local title="" labels=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) [ $# -ge 2 ] || err "create-issue: --title requires a value"; title="$2"; shift 2 ;;
      --label) [ $# -ge 2 ] || err "create-issue: --label requires a value"; labels+=("$2"); shift 2 ;;
      *) err "create-issue: unknown flag '$1'" ;;
    esac
  done
  [ -n "$title" ] || err "create-issue: --title is required"
  local body
  body="$(read_stdin create-issue)"
  local provider
  provider="$(resolve_provider)"

  local output rc=0
  if [ "$provider" = "gh" ]; then
    # Body via stdin (--body-file -) keeps it off argv: not visible in `ps`, no ARG_MAX limit.
    local args=(issue create --title "$title" --body-file -)
    if [ "${#labels[@]}" -gt 0 ]; then
      for l in "${labels[@]}"; do args+=(--label "$l"); done
    fi
    output="$(printf '%s' "$body" | gh "${args[@]}" 2>&1)" || rc=$?
  else
    # glab 1.97.0 has no --description-file (checked in `issue create --help`), so the body goes on argv via --description.
    local repo
    repo="$(glab_repo)"
    local args=(issue create -R "$repo" --yes --title "$title" --description "$body")
    if [ "${#labels[@]}" -gt 0 ]; then
      for l in "${labels[@]}"; do args+=(--label "$l"); done
    fi
    output="$(glab "${args[@]}" </dev/null 2>&1)" || rc=$?
  fi
  finish_create "$rc" "$output"
}

cmd_view_issue() {
  local id="${1:-}"
  [ -n "$id" ] || err "view-issue: issue id is required"
  local provider
  provider="$(resolve_provider)"
  if [ "$provider" = "gh" ]; then
    gh issue view "$id" </dev/null
  else
    local repo
    repo="$(glab_repo)"
    glab issue view -R "$repo" "$id" </dev/null
  fi
}

cmd_comment_issue() {
  local id="${1:-}"
  [ -n "$id" ] || err "comment-issue: issue id is required"
  local msg
  msg="$(read_stdin comment-issue)"
  local provider
  provider="$(resolve_provider)"
  if [ "$provider" = "gh" ]; then
    printf '%s' "$msg" | gh issue comment "$id" --body-file -
  else
    local repo
    repo="$(glab_repo)"
    glab issue note -R "$repo" "$id" --message "$msg" </dev/null
  fi
}

cmd_list_labels() {
  local provider
  provider="$(resolve_provider)"
  if [ "$provider" = "gh" ]; then
    gh label list </dev/null
  else
    local repo
    repo="$(glab_repo)"
    glab label list -R "$repo" </dev/null
  fi
}

cmd_create_change_request() {
  local base="" title=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --base) [ $# -ge 2 ] || err "create-change-request: --base requires a value"; base="$2"; shift 2 ;;
      --title) [ $# -ge 2 ] || err "create-change-request: --title requires a value"; title="$2"; shift 2 ;;
      *) err "create-change-request: unknown flag '$1'" ;;
    esac
  done
  [ -n "$base" ] || err "create-change-request: --base is required"
  [ -n "$title" ] || err "create-change-request: --title is required"
  local body
  body="$(read_stdin create-change-request)"
  local provider
  provider="$(resolve_provider)"
  local source
  source="$(git rev-parse --abbrev-ref HEAD)"

  if [ "$provider" = "glab" ]; then
    glab_create_mr "$base" "$source" "$title" "$body"
    return
  fi
  local output rc=0
  output="$(printf '%s' "$body" | gh pr create --base "$base" --title "$title" --body-file - 2>&1)" || rc=$?
  finish_create "$rc" "$output"
}

usage() {
  err "usage: paf-vcs <verb> [args...] — verbs: provider, auth-status, create-issue, view-issue, comment-issue, list-labels, create-change-request"
}

main() {
  local verb="${1:-}"
  [ -n "$verb" ] || usage
  shift
  case "$verb" in
    provider) detect_provider ;;
    auth-status) cmd_auth_status ;;
    create-issue) cmd_create_issue "$@" ;;
    view-issue) cmd_view_issue "$@" ;;
    comment-issue) cmd_comment_issue "$@" ;;
    list-labels) cmd_list_labels ;;
    create-change-request) cmd_create_change_request "$@" ;;
    *) err "unknown verb '$verb' — verbs: provider, auth-status, create-issue, view-issue, comment-issue, list-labels, create-change-request" ;;
  esac
}

main "$@"